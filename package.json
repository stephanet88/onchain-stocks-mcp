{
  "name": "onchain-stocks-mcp",
  "version": "0.3.1",
  "description": "MCP server: what a tokenized stock on Solana really costs against the real share",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mcp": "node src/main.ts",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "catalog": "node --env-file-if-exists=.env scripts/build-catalog.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.0",
    "eslint": "10.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "bin": {
    "onchain-stocks-mcp": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephanet88/onchain-stocks-mcp.git"
  },
  "homepage": "https://github.com/stephanet88/onchain-stocks-mcp",
  "keywords": [
    "mcp",
    "mcp-server",
    "solana",
    "tokenized-stocks",
    "xstocks"
  ]
}
